// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output = "../src/prisma/generated/client"
  moduleFormat = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

// Contoh Enum role seperti di ERD
enum Role {
  ADMIN
  LAWYER
  CLIENT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum Speciality {
  PIDANA
  PERDATA
  KETENAGAKERJAAN
  KELUARGA
  BISNIS
  LAINNYA
}

model User {
  id                  String             @id @default(uuid())
  email               String             @unique
  phone_number        String             @unique
  password            String             // Akan disimpan dalam bentuk hash bcrypt
  name                String
  nik                 String?            @unique
  address             String?            @db.Text
  province            String?
  city                String?
  role                Role               @default(CLIENT)
  ktp_image           String?
  verification_status VerificationStatus @default(PENDING)
  is_active           Boolean            @default(false)
  profile_image       String?
  created_at          DateTime           @default(now())
  updated_at          DateTime           @updatedAt

  lawyer              Lawyer?
  client              Client?
  chats               Chat[]
  educations          Education[]
  bot_sessions        BotSession[]

  @@map("users")
}

model Lawyer {
  id                String       @id @default(uuid())
  user_id           String       @unique
  license_number    String       @unique
  license_upload    String?
  organization_name String?
  office_address    String?      @db.Text
  experience        String?      @db.Text
  speciality        Speciality?

  user              User         @relation(fields: [user_id], references: [id])
  cases             Case[]
  consultations     Consultation[]
  reviews           Review[]

  @@map("lawyers")
}

model Client {
  id          String   @id @default(uuid())
  user_id     String   @unique
  sktm_upload String?

  user          User           @relation(fields: [user_id], references: [id])
  cases         Case[]
  reviews       Review[]
  consultations Consultation[]

  @@map("clients")
}

enum CaseStatus {
  SUBMITTED
  ACCEPTED
  IN_PROGRESS
  CLOSED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

enum CategoryType {
  CASE
  NEWS
}

enum ChatStatus {
  SENT
  DELIVERED
  READ
}

model Category {
  id         String       @id @default(uuid())
  name       String
  type       CategoryType
  cases      Case[]
  educations Education[]

  @@map("categories")
}

model Case {
  id             String       @id @default(uuid())
  client_id      String
  lawyer_id      String?
  category_id    String
  title          String
  description    String       @db.Text
  location       String?
  date           DateTime?
  opponent       String?
  estimated_loss Decimal?     @db.Decimal(15, 2)
  legal_goal     String?      @db.Text
  urgency        Urgency      @default(LOW)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  client         Client          @relation(fields: [client_id], references: [id])
  lawyer         Lawyer?         @relation(fields: [lawyer_id], references: [id])
  category       Category        @relation(fields: [category_id], references: [id])
  documents      CaseDocument[]
  progress       CaseProgress[]
  consultations  Consultation[]
  reviews        Review[]
  chats          Chat[]

  @@map("cases")
}

model CaseDocument {
  id         String   @id @default(uuid())
  case_id    String
  filename   String
  file_url   String

  case       Case     @relation(fields: [case_id], references: [id])

  @@map("case_documents")
}

model CaseProgress {
  id         String     @id @default(uuid())
  case_id    String
  status     CaseStatus
  note       String?    @db.Text
  created_at DateTime   @default(now())

  case       Case       @relation(fields: [case_id], references: [id])

  @@map("case_progress")
}

model Consultation {
  id              String   @id @default(uuid())
  case_id         String
  lawyer_id       String
  client_id       String
  title           String
  consultation_at DateTime
  is_online       Boolean  @default(false)
  link_meet       String?
  location        String?
  notes           String?  @db.Text

  case            Case     @relation(fields: [case_id], references: [id])
  lawyer          Lawyer   @relation(fields: [lawyer_id], references: [id])
  client          Client   @relation(fields: [client_id], references: [id])

  @@map("consultations")
}

model Review {
  id         String   @id @default(uuid())
  case_id    String   @unique
  client_id  String
  lawyer_id  String
  rating     Int
  comment    String?  @db.Text
  created_at DateTime @default(now())

  case       Case     @relation(fields: [case_id], references: [id])
  client     Client   @relation(fields: [client_id], references: [id])
  lawyer     Lawyer   @relation(fields: [lawyer_id], references: [id])

  @@map("reviews")
}

model Chat {
  id         String     @id @default(uuid())
  case_id    String
  sender_id  String
  message    String     @db.Text
  status     ChatStatus @default(SENT)
  created_at DateTime   @default(now())

  case       Case       @relation(fields: [case_id], references: [id])
  sender     User       @relation(fields: [sender_id], references: [id])
  files      ChatFile[]

  @@map("chats")
}

model ChatFile {
  id       String @id @default(uuid())
  chat_id  String
  filename String
  file_url String

  chat     Chat   @relation(fields: [chat_id], references: [id])

  @@map("files")
}

model Education {
  id          String   @id @default(uuid())
  category_id String
  author_id   String
  title       String
  content     String   @db.Text
  image_url   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  category    Category @relation(fields: [category_id], references: [id])
  author      User     @relation(fields: [author_id], references: [id])

  @@map("educations")
}

model BotSession {
  id         String       @id @default(uuid())
  user_id    String
  title      String       @default("New Chat")
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  user       User         @relation(fields: [user_id], references: [id])
  messages   BotMessage[]

  @@map("bot_sessions")
}

model BotMessage {
  id         String     @id @default(uuid())
  session_id String
  role       String     // "user" or "ai"
  content    String     @db.Text
  created_at DateTime   @default(now())

  session    BotSession @relation(fields: [session_id], references: [id], onDelete: Cascade)

  @@map("bot_messages")
}

model DocumentVector {
  id         String                 @id @default(uuid())
  content    String                 @db.Text
  embedding  Unsupported("vector")
  metadata   Json?
  created_at DateTime               @default(now())

  @@map("document_vectors")
}
