# Template variabel environment untuk Staging
# Salin file ini: cp .env.staging.example .env.staging

# ============================================================
# Database PostgreSQL
# ============================================================
POSTGRES_USER=probono_user
POSTGRES_PASSWORD=ganti_dengan_password_yang_kuat
POSTGRES_DB=probono_staging
POSTGRES_PORT=5433

# ============================================================
# Backend NestJS
# ============================================================
BACKEND_PORT=3000
JWT_SECRET=ganti_dengan_jwt_secret_yang_panjang_dan_acak

# ============================================================
# API Keys (isi dengan key yang valid)
# ============================================================
JINA_API_KEY=
GEMINI_API_KEY=
